# Copie para .env e preencha. O .env NÃO vai para o git.
# cp .env.example .env

# --- Domínio e TLS ----------------------------------------------------------
DOMINIO=fabricadetrecos.com.br
EMAIL_TLS=contato@fabricadetrecos.com.br

# --- Instagram --------------------------------------------------------------
# Como conseguir estes dois valores: veja INSTAGRAM.md
# Sem eles o site sobe normal, só mostra o link do perfil no lugar do feed.
IG_TOKEN=
IG_USER_ID=

# --- Diversos ---------------------------------------------------------------
LOG_LEVEL=info
