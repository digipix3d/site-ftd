---
import { servicos, zap } from '../content/conteudo';

/** Mapeia a cor semântica de cada serviço para o token de cor certo. */
const cores = {
  teal: 'var(--c-teal)',
  amarelo: 'var(--c-amarelo)',
  vermelho: 'var(--c-vermelho)',
} as const;

/** Mapeia a cor semântica para a variante de botão já pronta em tokens.css
    — é o que garante que texto sobre amarelo saia escuro, nunca branco. */
const variantesBotao = {
  teal: 'btn--teal',
  amarelo: 'btn--amarelo',
  vermelho: '',
} as const;

type Cor = keyof typeof cores;
---

<section id="servicos" class="servicos secao">
  <div class="container">
    <div class="servicos__cabecalho">
      <h2>{servicos.titulo}</h2>
      <p class="servicos__subtitulo">{servicos.subtitulo}</p>
    </div>

    <div class="servicos__grade">
      {servicos.itens.map((item, i) => (
        <article
          class:list={[
            'cartao',
            'servicos__cartao',
            i % 2 === 0 ? 'servicos__cartao--esq' : 'servicos__cartao--dir',
          ]}
          style={`--servicos-cor: ${cores[item.cor as Cor]}`}
        >
          <span class="servicos__faixa" aria-hidden="true"></span>

          <div class="servicos__icone" aria-hidden="true">
            {item.icone === 'modelagem' && (
              <svg viewBox="0 0 64 64" fill="none" stroke="var(--c-carvao)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <rect x="14" y="26" width="20" height="20" />
                <rect x="28" y="14" width="20" height="20" />
                <line x1="14" y1="26" x2="28" y2="14" />
                <line x1="34" y1="26" x2="48" y2="14" />
                <line x1="34" y1="46" x2="48" y2="34" />
                <line x1="14" y1="46" x2="28" y2="34" />
              </svg>
            )}
            {item.icone === 'impressao' && (
              <svg viewBox="0 0 64 64" fill="none" stroke="var(--c-carvao)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <rect x="8" y="50" width="48" height="6" rx="2" />
                <line x1="14" y1="50" x2="14" y2="10" />
                <line x1="50" y1="50" x2="50" y2="10" />
                <line x1="14" y1="10" x2="50" y2="10" />
                <line x1="14" y1="24" x2="50" y2="24" />
                <line x1="32" y1="24" x2="32" y2="34" />
                <polygon points="24,46 32,32 40,46" />
              </svg>
            )}
            {item.icone === 'vr' && (
              <svg viewBox="0 0 64 64" fill="none" stroke="var(--c-carvao)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <rect x="8" y="20" width="48" height="26" rx="10" />
                <circle cx="22" cy="33" r="7" />
                <circle cx="42" cy="33" r="7" />
                <line x1="6" y1="26" x2="0" y2="22" />
                <line x1="6" y1="40" x2="0" y2="44" />
                <line x1="58" y1="26" x2="64" y2="22" />
                <line x1="58" y1="40" x2="64" y2="44" />
              </svg>
            )}
          </div>

          <h3>{item.titulo}</h3>
          <p class="servicos__resumo">{item.resumo}</p>
          <p class="servicos__texto">{item.texto}</p>

          <a
            href={zap(item.msg)}
            class:list={['btn', 'servicos__botao', variantesBotao[item.cor as Cor]]}
            target="_blank"
            rel="noopener"
          >
            {item.cta}
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .servicos {
    background: var(--fundo);
  }

  .servicos__cabecalho {
    max-width: var(--largura-texto);
    margin-inline: auto;
    margin-block-end: var(--e-8);
    text-align: center;
  }

  .servicos__subtitulo {
    font-size: var(--t-md);
    color: var(--texto-suave);
  }

  .servicos__grade {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--e-7);
  }

  .servicos__cartao {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: transform var(--transicao-mole), box-shadow var(--transicao);
  }
  .servicos__cartao--esq { transform: rotate(-1deg); }
  .servicos__cartao--dir { transform: rotate(1deg); }

  .servicos__cartao--esq:hover {
    transform: rotate(-1deg) translateY(-8px);
    box-shadow: var(--sombra-lg);
  }
  .servicos__cartao--dir:hover {
    transform: rotate(1deg) translateY(-8px);
    box-shadow: var(--sombra-lg);
  }

  .servicos__faixa {
    position: absolute;
    inset: 0 0 auto 0;
    height: 10px;
    background: var(--servicos-cor);
    border-bottom: var(--borda-fina);
  }

  .servicos__icone {
    align-self: flex-start;
    width: 72px;
    height: 72px;
    margin-block: var(--e-4) var(--e-4);
    padding: var(--e-2);
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--servicos-cor);
    border: var(--borda);
    border-radius: var(--raio);
  }
  .servicos__icone svg {
    width: 100%;
    height: 100%;
  }

  .servicos__resumo {
    font-family: var(--fonte-titulo);
    font-weight: var(--peso-medio);
    color: var(--texto);
  }

  .servicos__texto {
    color: var(--texto-suave);
    flex-grow: 1;
  }

  .servicos__botao {
    align-self: flex-start;
    margin-block-start: var(--e-2);
  }

  @media (min-width: 860px) {
    .servicos__grade {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
