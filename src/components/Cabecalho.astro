---
import { Image } from 'astro:assets';
import { navegacao, empresa, zap } from '../content/conteudo';
import logo from '../assets/marca/FabricaDeTrecos2.png';
---

<header class="cab" id="cabecalho">
  <div class="container cab__interno">
    <a href="/" class="cab__marca" aria-label={`${empresa.nome} — início`}>
      <Image src={logo} alt="" width={56} height={56} class="cab__logo" loading="eager" />
      <span class="cab__nome">Fábrica<br />de Trecos</span>
    </a>

    <nav class="cab__nav" aria-label="Navegação principal">
      <ul class="cab__lista">
        {navegacao.map((item) => (
          <li><a href={item.href} class="cab__link">{item.rotulo}</a></li>
        ))}
      </ul>
    </nav>

    <a href={zap('Oi! Vim pelo site da Fábrica de Trecos.')}
       class="btn cab__zap"
       target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
        <path d="M17.5 14.4c-.3-.2-1.7-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.7 1-.9 1.2-.2.2-.3.2-.6.1-.3-.2-1.2-.5-2.3-1.4-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.5.1-.6l.5-.5c.1-.2.2-.3.3-.5 0-.2 0-.4 0-.5 0-.2-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.7-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.1-.3-.2-.6-.3z"/>
        <path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2zm0 18.2c-1.6 0-3.1-.4-4.4-1.2l-.3-.2-3.1.8.8-3-.2-.3A8.2 8.2 0 1 1 12 20.2z"/>
      </svg>
      WhatsApp
    </a>

    <button class="cab__botao" id="menu-botao" aria-expanded="false" aria-controls="menu-movel">
      <span class="sr-only">Abrir menu</span>
      <span class="cab__hamburguer" aria-hidden="true"></span>
    </button>
  </div>

  <div class="cab__movel" id="menu-movel" hidden>
    <ul class="cab__lista-movel">
      {navegacao.map((item) => (
        <li><a href={item.href} class="cab__link-movel">{item.rotulo}</a></li>
      ))}
    </ul>
    <a href={zap('Oi! Vim pelo site da Fábrica de Trecos.')}
       class="btn btn--grande" target="_blank" rel="noopener">Chamar no WhatsApp</a>
  </div>
</header>

<script>
  const botao = document.getElementById('menu-botao');
  const menu = document.getElementById('menu-movel');

  function fechar() {
    botao?.setAttribute('aria-expanded', 'false');
    menu?.setAttribute('hidden', '');
    document.body.style.removeProperty('overflow');
  }

  botao?.addEventListener('click', () => {
    const aberto = botao.getAttribute('aria-expanded') === 'true';
    if (aberto) {
      fechar();
    } else {
      botao.setAttribute('aria-expanded', 'true');
      menu?.removeAttribute('hidden');
      document.body.style.overflow = 'hidden';
    }
  });

  // fecha ao clicar num link ou apertar Esc
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).tagName === 'A') fechar();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') fechar();
  });

  // encolhe o cabeçalho depois que a pessoa rola um pouco
  const cab = document.getElementById('cabecalho');
  const aoRolar = () => cab?.classList.toggle('cab--rolado', window.scrollY > 40);
  aoRolar();
  window.addEventListener('scroll', aoRolar, { passive: true });
</script>

<style>
  .cab {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    background: var(--c-creme-claro);
    border-bottom: var(--borda);
    transition: box-shadow var(--transicao), padding var(--transicao);
  }
  .cab--rolado { box-shadow: 0 4px 0 var(--contorno); }

  .cab__interno {
    display: flex;
    align-items: center;
    gap: var(--e-4);
    padding-block: var(--e-3);
  }

  .cab__marca {
    display: flex;
    align-items: center;
    gap: var(--e-3);
    text-decoration: none;
    color: var(--texto);
    flex-shrink: 0;
  }
  .cab__logo {
    border: var(--borda-fina);
    border-radius: var(--raio-sm);
    background: var(--c-creme);
  }
  .cab__nome {
    font-family: var(--fonte-titulo);
    font-weight: var(--peso-black);
    font-size: var(--t-sm);
    line-height: 1.05;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }

  .cab__nav { margin-inline-start: auto; }
  .cab__lista {
    display: flex;
    gap: var(--e-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .cab__link {
    font-family: var(--fonte-titulo);
    font-weight: var(--peso-medio);
    font-size: var(--t-sm);
    color: var(--texto);
    text-decoration: none;
    padding-block: var(--e-1);
    border-bottom: 3px solid transparent;
    transition: border-color var(--transicao), color var(--transicao);
  }
  .cab__link:hover { color: var(--c-teal); border-bottom-color: var(--c-amarelo); }

  .cab__zap { padding: var(--e-2) var(--e-4); font-size: var(--t-sm); }

  .cab__botao {
    display: none;
    width: 46px; height: 46px;
    padding: 0;
    background: var(--c-amarelo);
    border: var(--borda);
    border-radius: var(--raio-sm);
    box-shadow: var(--sombra-sm);
    cursor: pointer;
  }
  .cab__hamburguer,
  .cab__hamburguer::before,
  .cab__hamburguer::after {
    display: block;
    width: 20px; height: 3px;
    margin-inline: auto;
    background: var(--c-carvao);
    border-radius: 2px;
    transition: transform var(--transicao), opacity var(--transicao);
  }
  .cab__hamburguer { position: relative; }
  .cab__hamburguer::before,
  .cab__hamburguer::after { content: ''; position: absolute; left: 0; }
  .cab__hamburguer::before { top: -6px; }
  .cab__hamburguer::after { top: 6px; }

  [aria-expanded='true'] .cab__hamburguer { background: transparent; }
  [aria-expanded='true'] .cab__hamburguer::before { transform: translateY(6px) rotate(45deg); }
  [aria-expanded='true'] .cab__hamburguer::after { transform: translateY(-6px) rotate(-45deg); }

  .cab__movel {
    padding: var(--e-5) var(--gutter) var(--e-7);
    background: var(--c-creme);
    border-top: var(--borda-fina);
  }
  .cab__lista-movel {
    list-style: none;
    margin: 0 0 var(--e-5);
    padding: 0;
    display: grid;
    gap: var(--e-1);
  }
  .cab__link-movel {
    display: block;
    padding: var(--e-3) var(--e-4);
    font-family: var(--fonte-titulo);
    font-weight: var(--peso-forte);
    font-size: var(--t-md);
    color: var(--texto);
    text-decoration: none;
    border-radius: var(--raio-sm);
  }
  .cab__link-movel:hover { background: var(--c-amarelo); }

  @media (max-width: 900px) {
    .cab__nav { display: none; }
    .cab__botao { display: block; }
    .cab__zap { margin-inline-start: auto; }
  }
  @media (max-width: 560px) {
    .cab__zap { display: none; }
    .cab__botao { margin-inline-start: auto; }
  }
</style>
