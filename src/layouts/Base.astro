---
import '../styles/tokens.css';
import Cabecalho from '../components/Cabecalho.astro';
import Rodape from '../components/Rodape.astro';
import { empresa, seo, linkMaps } from '../content/conteudo';

interface Props {
  titulo?: string;
  descricao?: string;
  imagem?: string;
}

const {
  titulo = seo.titulo,
  descricao = seo.descricao,
  imagem = '/og.jpg',
} = Astro.props;

const site = `https://${empresa.dominio}`;
const canonical = new URL(Astro.url.pathname, site).href;
const gaId = import.meta.env.PUBLIC_GA_ID ?? 'G-TD3ERDC7FE';

// Dados estruturados: ajuda o Google a mostrar telefone, horário e endereço
// direto no resultado de busca.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: empresa.nome,
  description: seo.descricao,
  url: site,
  telephone: `+55${empresa.whatsapp.slice(2)}`,
  email: empresa.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${empresa.endereco.rua} — ${empresa.endereco.galeria}, ${empresa.endereco.loja}`,
    addressLocality: empresa.cidade,
    addressRegion: empresa.estado,
    postalCode: empresa.endereco.cep,
    addressCountry: empresa.pais,
  },
  hasMap: linkMaps,
  sameAs: [empresa.instagram, empresa.facebook],
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '09:00',
    closes: '18:00',
  }],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f5b722" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={empresa.nome} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(imagem, site).href} />
    <meta property="og:locale" content="pt_BR" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Fontes servidas pelo nosso próprio domínio: nenhuma requisição a terceiros -->
    <link rel="preload" href="/fontes/fredoka-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fontes/nunito-latin.woff2" as="font" type="font/woff2" crossorigin />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <a href="#conteudo" class="pular">Pular para o conteúdo</a>
    <Cabecalho />
    <main id="conteudo">
      <slot />
    </main>
    <Rodape />

    {gaId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}
  </body>
</html>

<style is:global>
  /* Fontes variáveis: um arquivo cobre toda a faixa de peso.
     Separadas por subset para o navegador só baixar latin-ext se precisar. */
  @font-face {
    font-family: 'Fredoka';
    src: url('/fontes/fredoka-latin.woff2') format('woff2');
    font-weight: 300 700;
    font-display: swap;
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA,
                   U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122,
                   U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: 'Fredoka';
    src: url('/fontes/fredoka-latin-ext.woff2') format('woff2');
    font-weight: 300 700;
    font-display: swap;
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF,
                   U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF,
                   U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }
  @font-face {
    font-family: 'Nunito Sans';
    src: url('/fontes/nunito-latin.woff2') format('woff2');
    font-weight: 200 900;
    font-display: swap;
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA,
                   U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122,
                   U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: 'Nunito Sans';
    src: url('/fontes/nunito-latin-ext.woff2') format('woff2');
    font-weight: 200 900;
    font-display: swap;
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF,
                   U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF,
                   U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }

  /* Link que só aparece para quem navega por teclado */
  .pular {
    position: absolute;
    left: var(--e-4);
    top: -100px;
    z-index: var(--z-modal);
    padding: var(--e-3) var(--e-5);
    background: var(--c-amarelo);
    color: var(--c-carvao);
    border: var(--borda);
    border-radius: var(--raio);
    font-family: var(--fonte-titulo);
    font-weight: var(--peso-forte);
    text-decoration: none;
    transition: top var(--transicao);
  }
  .pular:focus { top: var(--e-4); }
</style>
