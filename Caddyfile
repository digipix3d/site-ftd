{
	email {$EMAIL_TLS}
}

# www redireciona pro domínio sem www (decisão do projeto)
www.{$DOMINIO} {
	redir https://{$DOMINIO}{uri} permanent
}

{$DOMINIO} {
	encode zstd gzip

	header {
		# HSTS: só depois de confirmar que o HTTPS está de pé.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}

	# O feed do Instagram serve imagens do CDN da Meta e o Google Analytics
	# precisa do googletagmanager. Fora isso, nada de terceiros.
	#
	# O Treco em 3D exige duas permissões a mais, e sem elas ele não gira:
	#   'wasm-unsafe-eval' — o decodificador Draco é WebAssembly, e compilar wasm
	#     é bloqueado por padrão. É a versão estreita: libera wasm, NÃO libera
	#     eval() de JavaScript, que continua barrado.
	#   worker-src 'self' blob: — o Draco roda num Web Worker criado a partir de
	#     um blob:. Sem a diretiva o CSP cai no default-src 'self' e recusa.
	#   connect-src blob: — as texturas vêm embutidas no .glb; o three.js as
	#     transforma em blob: e as lê com fetch(), que é governado por
	#     connect-src e NÃO por img-src. Sem isso o modelo carrega e gira, só
	#     que todo branco.
	header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https://*.cdninstagram.com https://*.fbcdn.net; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://www.googletagmanager.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' blob: https://www.google-analytics.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"

	reverse_proxy web:3000
}
