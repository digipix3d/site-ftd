{
	email {$EMAIL_TLS}
}

# www redireciona pro domínio sem www (decisão do projeto)
www.{$DOMINIO} {
	redir https://{$DOMINIO}{uri} permanent
}

# Existe só para o Caddy obter e RENOVAR o certificado TLS que o servidor de
# e-mail usa (ele monta o volume de certificados somente-leitura). Assim não
# há certbot separado nem renovação manual. Não serve conteúdo.
mail.{$DOMINIO} {
	respond "Servidor de e-mail da Fábrica de Trecos." 200
}

{$DOMINIO} {
	encode zstd gzip

	header {
		# HSTS: só depois de confirmar que o HTTPS está de pé.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}

	# O feed do Instagram serve imagens do CDN da Meta e o Google Analytics
	# precisa do googletagmanager. Fora isso, nada de terceiros.
	header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https://*.cdninstagram.com https://*.fbcdn.net; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' https://www.google-analytics.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"

	reverse_proxy web:3000
}
